# ── DATABASE (NEON) ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require

# ── AUTH (NextAuth v5) ────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32
NEXTAUTH_URL=http://localhost:3001

# ── API KEY ───────────────────────────────────────────────────────────────────
# Key that external callers must send as x-api-key header
INTERNAL_ENV_API_KEY=generate_with_openssl_rand_hex_32

# ── APP URL (used in docs portal to build full endpoint URLs) ─────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── VENDOR: KARZA / TKYC (PAN Profile — /api/verify/pan) ──────────────────────
# v1: single-tenant. The tenant's Karza key, injected server-side on every call.
# Never commit the real value. On the server this lives in the systemd
# EnvironmentFile, not in the repo.
KARZA_KEY=your_karza_api_key
# Vendor base URL. Test by default; set the production URL for prod.
KARZA_BASE_URL=https://testapi.karza.in
